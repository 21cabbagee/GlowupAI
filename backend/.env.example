# Copy these into your secret manager or process environment. Do not commit
# a real key or a filled-in copy of this file (`.env` and `.env.*` are
# git-ignored; this file, `.env.example`, is the only one meant to be
# committed).
#
# Full variable surface, source of truth: backend/glowupai/config.py.
# See DEPLOY.md for the annotated required/default/breaks-without-it table.

# --- Database ----------------------------------------------------------
# Supabase provides this PostgreSQL connection string. A local SQLite file is
# used only when no database URL is set (tests/development).
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# DATABASE_URL=  # generic override supported for local CI
GLOWUPAI_DB_POOL_MIN_SIZE=1
GLOWUPAI_DB_POOL_MAX_SIZE=10
GLOWUPAI_DB_CONNECT_TIMEOUT=10
GLOWUPAI_DB_POOL_TIMEOUT=30
GLOWUPAI_DB_STATEMENT_TIMEOUT=30000
# SQLite fallback path, only read when no DATABASE_URL/*_URL is set.
# GLOWUPAI_DB_PATH=.data/glowupai.sqlite3

# --- Photo storage -------------------------------------------------------
# Production/staging use a private Supabase Storage bucket. The service-role
# key is backend-only and must never be put in the Android project.
# Uncomment all Supabase server values together when running against a local
# development project; otherwise the app uses the SQLite/memory test fallback.
# SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Current Supabase aliases are accepted too; keep the secret key backend-only.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_STORAGE_BUCKET=user-images
# Development may use encrypted local disk by setting GLOWUPAI_PHOTO_DIR and
# GLOWUPAI_PHOTO_KEY, or inject MemoryPhotoStore in tests.
# GLOWUPAI_PHOTO_DIR=/data/photos
# GLOWUPAI_PHOTO_KEY=<base64-encoded-32-byte-key>
GLOWUPAI_RAW_RETENTION_DAYS=730

# --- Google Play Billing ----------------------------------------------------
# Required for real Android subscriptions. Credentials stay backend-only.
GLOWUPAI_BILLING_KEY=
GLOWUPAI_PLAY_PACKAGE_NAME=com.glowup.ai
GLOWUPAI_PLAY_PRODUCT_IDS=premium_monthly,premium_yearly
GLOWUPAI_PLAY_RTDN_AUDIENCE=https://api.example.com/api/billing/play/notifications
GLOWUPAI_PLAY_RTDN_EMAIL=play-rtdn-push@your-project.iam.gserviceaccount.com
GLOWUPAI_PLAY_SERVICE_ACCOUNT_JSON_B64=

# --- OpenAI GPT-5.6 Luna (paid image + text fallback; backend only) --------
GLOWUPAI_LUNA_ENABLED=0
OPENAI_API_KEY=
# GLOWUPAI_LUNA_API_KEY=  # explicit alias supported for secret managers
GLOWUPAI_LUNA_MODEL=gpt-5.6-luna
GLOWUPAI_LUNA_ENDPOINT=https://api.openai.com/v1/responses
GLOWUPAI_LUNA_REASONING_EFFORT=medium
GLOWUPAI_LUNA_MONTHLY_SPEND_CAP_USD=0
GLOWUPAI_LUNA_REASONING_FALLBACK=1
GLOWUPAI_LUNA_IMAGE_MAX_EDGE=768
GLOWUPAI_LUNA_IMAGE_JPEG_QUALITY=82
GLOWUPAI_LUNA_IMAGE_DETAIL=low
GLOWUPAI_LUNA_LABEL_DETAIL=auto
GLOWUPAI_LUNA_ESCALATE_DETAIL=0
# Conservative pre-request quota estimates; replace after reconciling real
# provider billing. These keep the monthly cap effective if usage metadata is
# missing. Optional hard request/token/user limits are fail-closed controls.
GLOWUPAI_LUNA_IMAGE_ESTIMATED_TOKENS=3500
GLOWUPAI_LUNA_IMAGE_ESTIMATED_COST_USD=0.001
GLOWUPAI_LUNA_FALLBACK_ESTIMATED_TOKENS=1200
GLOWUPAI_LUNA_FALLBACK_ESTIMATED_COST_USD=0.0005
# GLOWUPAI_LUNA_MAX_REQUESTS_PER_WINDOW=1000
# GLOWUPAI_LUNA_MAX_TOKENS_PER_WINDOW=500000
# GLOWUPAI_LUNA_MAX_COST_USD_PER_WINDOW=20
# GLOWUPAI_LUNA_USER_DAILY_LIMIT=20

# --- Gemini text post-processing (never raw face images) -------------------
GEMINI_API_KEY=
# GLOWUPAI_GEMINI_API_KEY=
GLOWUPAI_GEMINI_MODEL=gemini-3.5-flash-lite
GLOWUPAI_GEMINI_ENABLED=1
GLOWUPAI_GEMINI_PERSONAL_DATA_ENABLED=1
GLOWUPAI_GEMINI_ELIGIBILITY_REVIEW_ID=replace_with_internal_approval_id
GLOWUPAI_AI_MAX_ATTEMPTS=2
GLOWUPAI_AI_TIMEOUT_SECONDS=12
GLOWUPAI_AI_DAILY_USER_LIMIT=0

# --- Supabase Auth ---------------------------------------------------------
# The backend validates Supabase access JWTs when auth is enabled. Production
# and staging manifests set this to 1; local development can use 0 with the
# SQLite/memory fallback.
GLOWUPAI_AUTH_REQUIRED=0

# --- Admin routes ----------------------------------------------------------
# Unset -> every /api/admin/* route (including the audit log) is hard
# disabled with 403. Set a long random value to enable them, and never
# reuse it anywhere else.
GLOWUPAI_ADMIN_TOKEN=

# --- Environment / model versioning ----------------------------------------
# MUST be "production" on every real deploy -- see the security note in
# DEPLOY.md about the legacy Gemini-key file bridge.
GLOWUPAI_ENV=production
# Belt-and-suspenders: forces the legacy first.py key bridge off regardless
# of GLOWUPAI_ENV. Set explicitly in production; do not rely on GLOWUPAI_ENV alone.
GLOWUPAI_DISABLE_LEGACY_KEY_FILE=1
GLOWUPAI_MODEL_VERSION=deterministic-3.0
GLOWUPAI_POLICY_VERSION=2026-01

# --- CORS Configuration ------------------------------------------------
# REQUIRED IN PRODUCTION: Comma-separated list of allowed origins
# Development default: localhost and emulator addresses
# Production: Must be explicitly configured
GLOWUPAI_ALLOWED_ORIGINS=https://app.glowup.ai,https://www.glowup.ai

# --- Production Features -----------------------------------------------
# Logging
GLOWUPAI_LOG_LEVEL=INFO
GLOWUPAI_JSON_LOGS=1

# Rate Limiting
GLOWUPAI_RATE_LIMIT_ENABLED=1
GLOWUPAI_RATE_LIMIT_FAIL_CLOSED=0
GLOWUPAI_RATE_LIMIT_CAPTURE_PER_MINUTE=10
GLOWUPAI_RATE_LIMIT_AUTH_PER_MINUTE=5
GLOWUPAI_RATE_LIMIT_DASHBOARD_PER_MINUTE=30
GLOWUPAI_RATE_LIMIT_API_PER_MINUTE=60

# Monitoring and operational threshold alerts
# REDIS_URL=redis://:password@localhost:6379/0
# GLOWUPAI_ALERT_WEBHOOK_URL=
GLOWUPAI_ALERT_COOLDOWN_SECONDS=900
GLOWUPAI_ALERT_ERROR_RATE_THRESHOLD=0.05
GLOWUPAI_ALERT_P95_LATENCY_MS=2000
GLOWUPAI_ALERT_MIN_REQUESTS=20
# GLOWUPAI_METRICS_TOKEN=

# Runtime kill switches and database backup artifacts
GLOWUPAI_CONTROLS_FILE=.data/runtime_controls.json
GLOWUPAI_KILL_SWITCH_FAIL_CLOSED=0
GLOWUPAI_BACKUP_DIR=.data/backups
GLOWUPAI_BACKUP_RETENTION_DAYS=30
GLOWUPAI_BACKUP_TIMEOUT_SECONDS=600

# Request Timeout (seconds)
GLOWUPAI_REQUEST_TIMEOUT=30

# OpenTelemetry (optional - for advanced observability)
OTEL_ENABLED=0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4317
# OTEL_SERVICE_NAME=glowupai

# --- Runtime ----------------------------------------------------------
# Injected by Render at runtime; do not hardcode. Only needed
# locally if you want to run uvicorn directly instead of the CLI/Docker
# defaults.
# PORT=8000

# Number of Uvicorn workers (adjust based on CPU cores)
# Formula: (2 * num_cores) + 1
# UVICORN_WORKERS=2
