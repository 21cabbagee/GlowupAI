# ============================================================================
# GlowUp AI Backend - Production Environment Variables Template
# ============================================================================
# Copy these to your hosting provider's production environment settings
# DO NOT commit the filled version with real secrets!
# ============================================================================

# ============================================================================
# REQUIRED - Must set these or deployment will fail
# ============================================================================

# Supabase project and server-only credentials
SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_JWT_SECRET=your_supabase_jwt_signing_secret
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Supabase's current key aliases. The secret key must remain backend-only.
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_JWKS_URL=https://your-production-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_BUCKET=user-images

# Environment Mode - MUST be production
GLOWUPAI_ENV=production
GLOWUPAI_DISABLE_LEGACY_KEY_FILE=1

# OpenAI GPT-5.6 Luna API - paid image analysis and text fallback
# Keep this key in the backend secret manager; never ship it in Android.
OPENAI_API_KEY=your_openai_api_key_here

# CORS - Your production frontend domain(s)
# Format: comma-separated, no spaces, no trailing slashes
# Example: https://app.glowup.com,https://www.glowup.com
GLOWUPAI_ALLOWED_ORIGINS=https://your-production-domain.com


# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# Production is fail-closed: every private route requires a verified Supabase token.
GLOWUPAI_AUTH_REQUIRED=1

# Admin routes protection token
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GLOWUPAI_ADMIN_TOKEN=your_secure_random_token_here


# ============================================================================
# PHOTO STORAGE CONFIGURATION
# ============================================================================
# Production web and worker services share the private Supabase bucket above.
# Do not expose SUPABASE_SERVICE_ROLE_KEY to Android or any browser client.
GLOWUPAI_RAW_RETENTION_DAYS=730
GLOWUPAI_BILLING_KEY=your_base64_32byte_billing_encryption_key_here
GLOWUPAI_PLAY_PACKAGE_NAME=com.glowup.ai
GLOWUPAI_PLAY_PRODUCT_IDS=premium_monthly,premium_yearly
GLOWUPAI_PLAY_RTDN_AUDIENCE=https://api.example.com/api/billing/play/notifications
GLOWUPAI_PLAY_RTDN_EMAIL=play-rtdn-push@your-project.iam.gserviceaccount.com
# Base64-encoded Google service-account JSON with Android Publisher API access.
# Keep this secret server-side; never add it to the Android app or web bundle.
GLOWUPAI_PLAY_SERVICE_ACCOUNT_JSON_B64=base64_encoded_service_account_json

# Development only:
# Leave GLOWUPAI_PHOTO_DIR and GLOWUPAI_PHOTO_KEY unset
# The test app uses memory storage and photos are lost on restart.


# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Set SUPABASE_DB_URL to the Supabase PostgreSQL connection string.
# DATABASE_URL is accepted as a generic CI/local override.
#
# Optional pool tuning (defaults are good for most cases):

SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
GLOWUPAI_DB_POOL_MIN_SIZE=1
GLOWUPAI_DB_POOL_MAX_SIZE=10
GLOWUPAI_DB_CONNECT_TIMEOUT=10
GLOWUPAI_DB_POOL_TIMEOUT=30
GLOWUPAI_DB_STATEMENT_TIMEOUT=30000

# Shared Redis for rate limits and runtime kill switches. Without Redis, the
# local fallback is bounded but cannot coordinate across web replicas.
# REDIS_URL=redis://:password@host:6379/0
GLOWUPAI_RATE_LIMIT_ENABLED=1
GLOWUPAI_RATE_LIMIT_FAIL_CLOSED=0
GLOWUPAI_RATE_LIMIT_CAPTURE_PER_MINUTE=10
GLOWUPAI_RATE_LIMIT_AUTH_PER_MINUTE=5
GLOWUPAI_RATE_LIMIT_DASHBOARD_PER_MINUTE=30
GLOWUPAI_RATE_LIMIT_API_PER_MINUTE=60

# Monitoring and threshold alerts. Never include user payloads in alert data.
# SENTRY_DSN=
# GLOWUPAI_ALERT_WEBHOOK_URL=
GLOWUPAI_ALERT_COOLDOWN_SECONDS=900
GLOWUPAI_ALERT_ERROR_RATE_THRESHOLD=0.05
GLOWUPAI_ALERT_P95_LATENCY_MS=2000
GLOWUPAI_ALERT_MIN_REQUESTS=20
# GLOWUPAI_METRICS_TOKEN=

# Runtime kill switches. Redis is canonical when configured; the file is the
# local fallback. Set a switch to 1 only as an explicit incident action.
GLOWUPAI_CONTROLS_FILE=.data/runtime_controls.json
GLOWUPAI_KILL_SWITCH_FAIL_CLOSED=1
# GLOWUPAI_KILL_SWITCH_MAINTENANCE=0
# GLOWUPAI_KILL_SWITCH_SIGNUPS=0
# GLOWUPAI_KILL_SWITCH_CAPTURES=0
# GLOWUPAI_KILL_SWITCH_AI=0
# GLOWUPAI_KILL_SWITCH_BILLING=0
# GLOWUPAI_KILL_SWITCH_REPROCESSING=0

# Portable database backup artifacts. Supabase PITR and Storage versioning
# remain required for the published recovery objectives.
GLOWUPAI_BACKUP_DIR=.data/backups
GLOWUPAI_BACKUP_RETENTION_DAYS=30
GLOWUPAI_BACKUP_TIMEOUT_SECONDS=600


# ============================================================================
# OPENAI LUNA / GEMINI AI CONFIGURATION
# ============================================================================

GLOWUPAI_LUNA_ENABLED=1
GLOWUPAI_LUNA_MODEL=gpt-5.6-luna
GLOWUPAI_LUNA_ENDPOINT=https://api.openai.com/v1/responses
GLOWUPAI_LUNA_REASONING_EFFORT=medium
GLOWUPAI_LUNA_MONTHLY_SPEND_CAP_USD=5
GLOWUPAI_LUNA_REASONING_FALLBACK=1
GLOWUPAI_LUNA_IMAGE_MAX_EDGE=768
GLOWUPAI_LUNA_IMAGE_JPEG_QUALITY=82
GLOWUPAI_LUNA_IMAGE_DETAIL=low
GLOWUPAI_LUNA_LABEL_DETAIL=auto
GLOWUPAI_LUNA_ESCALATE_DETAIL=0
GLOWUPAI_LUNA_IMAGE_ESTIMATED_TOKENS=3500
GLOWUPAI_LUNA_IMAGE_ESTIMATED_COST_USD=0.001
GLOWUPAI_LUNA_FALLBACK_ESTIMATED_TOKENS=1200
GLOWUPAI_LUNA_FALLBACK_ESTIMATED_COST_USD=0.0005
# Optional hard quota controls (set deliberately for the deployment).
# GLOWUPAI_LUNA_MAX_REQUESTS_PER_WINDOW=1000
# GLOWUPAI_LUNA_MAX_TOKENS_PER_WINDOW=500000
# GLOWUPAI_LUNA_MAX_COST_USD_PER_WINDOW=20
# GLOWUPAI_LUNA_USER_DAILY_LIMIT=20

GEMINI_API_KEY=your_gemini_api_key_here
GLOWUPAI_GEMINI_MODEL=gemini-3.5-flash-lite
GLOWUPAI_GEMINI_ENABLED=1
GLOWUPAI_GEMINI_PERSONAL_DATA_ENABLED=1
GLOWUPAI_GEMINI_ELIGIBILITY_REVIEW_ID=replace_with_internal_approval_id
GLOWUPAI_AI_MAX_ATTEMPTS=2
GLOWUPAI_AI_TIMEOUT_SECONDS=30
GLOWUPAI_AI_DAILY_USER_LIMIT=0


# ============================================================================
# MODEL & POLICY VERSIONS
# ============================================================================
# These have good defaults, only change if you know what you're doing

GLOWUPAI_MODEL_VERSION=deterministic-3.0
GLOWUPAI_POLICY_VERSION=2026-01


# ============================================================================
# AUTOMATICALLY SET BY RENDER
# ============================================================================
# These are automatically injected by Render - DO NOT SET MANUALLY:
# - PORT (Render sets this automatically)
# ============================================================================


# ============================================================================
# DEPLOYMENT CHECKLIST
# ============================================================================
# Before deploying, verify:
# [ ] SUPABASE_URL, SUPABASE_JWT_SECRET, and SUPABASE_SERVICE_ROLE_KEY are set
# [ ] GLOWUPAI_ENV=production
# [ ] GEMINI_API_KEY is a valid key from https://ai.google.dev/
# [ ] GLOWUPAI_ALLOWED_ORIGINS contains your actual production domain
# [ ] GLOWUPAI_ADMIN_TOKEN is a long secure random string
# [ ] Private Supabase Storage bucket exists and its name is configured
# [ ] Billing key, Play package/product IDs, and authenticated RTDN push configured
# [ ] Supabase PostgreSQL connection string is configured
# [ ] Shared Redis, alert webhook/Sentry, and protected metrics are configured
# [ ] Daily verified backup scheduler stores a copy outside the app container
# [ ] Render service/deploy IDs and rollback credentials are recorded securely
# ============================================================================
