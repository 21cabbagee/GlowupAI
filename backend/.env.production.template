# ============================================================================
# GlowUp AI Backend - Production Environment Variables Template
# ============================================================================
# Copy these to Railway Dashboard -> Settings -> Variables
# DO NOT commit the filled version with real secrets!
# ============================================================================

# ============================================================================
# REQUIRED - Must set these or deployment will fail
# ============================================================================

# Firebase Authentication - Your Firebase Project
GLOWUPAI_FIREBASE_PROJECT_ID=glowup-ai-38ae7

# Environment Mode - MUST be production
GLOWUPAI_ENV=production
GLOWUPAI_DISABLE_LEGACY_KEY_FILE=1

# Gemini API - For shelf scan OCR and Q&A features
# Get your key at: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# CORS - Your production frontend domain(s)
# Format: comma-separated, no spaces, no trailing slashes
# Example: https://app.glowup.com,https://www.glowup.com
GLOWUPAI_ALLOWED_ORIGINS=https://your-production-domain.com


# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# Enable authentication after frontend integration is complete
# Set to 0 during initial testing, then flip to 1 once confirmed working
GLOWUPAI_AUTH_REQUIRED=0

# Admin routes protection token
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GLOWUPAI_ADMIN_TOKEN=your_secure_random_token_here


# ============================================================================
# PHOTO STORAGE CONFIGURATION
# ============================================================================
# Choose ONE option:
#
# OPTION A: Railway Volume (Recommended for MVP)
# 1. Create volume in Railway: Settings -> Volumes -> New Volume
#    Name: photos, Mount path: /data/photos
# 2. Generate encryption key:
#    python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# 3. Set these variables:

GLOWUPAI_PHOTO_DIR=/data/photos
GLOWUPAI_PHOTO_KEY=your_base64_32byte_encryption_key_here
GLOWUPAI_RAW_RETENTION_DAYS=730

# OPTION B: In-Memory (Development Only)
# Leave GLOWUPAI_PHOTO_DIR and GLOWUPAI_PHOTO_KEY unset
# WARNING: Photos will be lost on every restart!


# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Railway automatically sets DATABASE_URL when you add PostgreSQL
# DO NOT manually set DATABASE_URL - Railway handles it
#
# Optional pool tuning (defaults are good for most cases):

GLOWUPAI_DB_POOL_MIN_SIZE=1
GLOWUPAI_DB_POOL_MAX_SIZE=10
GLOWUPAI_DB_CONNECT_TIMEOUT=10


# ============================================================================
# GEMINI / AI CONFIGURATION
# ============================================================================

GLOWUPAI_GEMINI_MODEL=gemini-3.5-flash-lite
GLOWUPAI_GEMINI_ENABLED=1


# ============================================================================
# MODEL & POLICY VERSIONS
# ============================================================================
# These have good defaults, only change if you know what you're doing

GLOWUPAI_MODEL_VERSION=deterministic-3.0
GLOWUPAI_POLICY_VERSION=2026-01


# ============================================================================
# AUTOMATICALLY SET BY RAILWAY
# ============================================================================
# These are automatically injected by Railway - DO NOT SET MANUALLY:
# - DATABASE_URL (from PostgreSQL service)
# - PORT (Railway sets this automatically)
# ============================================================================


# ============================================================================
# DEPLOYMENT CHECKLIST
# ============================================================================
# Before deploying, verify:
# [ ] GLOWUPAI_FIREBASE_PROJECT_ID is set to glowup-ai-38ae7
# [ ] GLOWUPAI_ENV=production
# [ ] GEMINI_API_KEY is a valid key from https://ai.google.dev/
# [ ] GLOWUPAI_ALLOWED_ORIGINS contains your actual production domain
# [ ] GLOWUPAI_ADMIN_TOKEN is a long secure random string
# [ ] Photo storage option chosen and configured
# [ ] PostgreSQL database provisioned in Railway
# [ ] Railway Volume created (if using OPTION A for photos)
# ============================================================================
