# Copy this file to app/keystore.properties (git-ignored - see .gitignore) and
# fill in real values once a release keystore has been generated.
#
#   keytool -genkey -v -keystore release.keystore -alias glowup-release \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# app/build.gradle.kts refuses requested staging/release builds without this
# file. It never falls back to debug signing.

# Path to the keystore file, relative to the app/ module directory (or an
# absolute path). Keep the keystore itself OUT of version control.
storeFile=release.keystore

# Keystore password.
storePassword=CHANGE_ME

# Alias of the key to use for signing.
keyAlias=glowup-release

# Password of that key (often the same as storePassword).
keyPassword=CHANGE_ME
