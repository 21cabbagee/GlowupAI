<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only override of app/src/main/res/xml/network_security_config.xml.
  Permits cleartext (HTTP) traffic only for explicitly configured local development
  hosts. This file is never packaged into staging or release builds.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <!-- Physical-device development on the current private Wi-Fi network. -->
        <domain includeSubdomains="true">192.168.1.247</domain>
    </domain-config>
</network-security-config>
