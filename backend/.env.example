# Copy these into your secret manager or process environment. Do not commit
# a real key or a filled-in copy of this file (`.env` and `.env.*` are
# git-ignored; this file, `.env.example`, is the only one meant to be
# committed).
#
# Full variable surface, source of truth: backend/glowupai/config.py.
# See DEPLOY.md for the annotated required/default/breaks-without-it table.

# --- Database ----------------------------------------------------------
# Any one of these three selects Postgres; if none are set the app falls
# back to a local SQLite file (GLOWUPAI_DB_PATH). Set exactly one in
# production -- DATABASE_URL is what Railway/Render/Neon inject by default.
DATABASE_URL=postgresql://glowupai:glowupai@127.0.0.1:5432/glowupai
# GLOWUPAI_DATABASE_URL=
# POSTGRES_URL=
GLOWUPAI_DB_POOL_MIN_SIZE=1
GLOWUPAI_DB_POOL_MAX_SIZE=10
GLOWUPAI_DB_CONNECT_TIMEOUT=10
GLOWUPAI_DB_POOL_TIMEOUT=30
GLOWUPAI_DB_STATEMENT_TIMEOUT=30000
# SQLite fallback path, only read when no DATABASE_URL/*_URL is set.
# GLOWUPAI_DB_PATH=.data/glowupai.sqlite3

# --- Photo storage -------------------------------------------------------
# Unset -> in-memory store: photos vanish on every process restart, not just
# redeploy. Set both of these for encrypted-at-rest local disk storage; see
# DEPLOY.md "Persistent photo storage" for why that still is not enough on
# Railway/Render without an attached persistent volume.
# GLOWUPAI_PHOTO_DIR=/data/photos
# GLOWUPAI_PHOTO_KEY=<base64-encoded-32-byte-key>
GLOWUPAI_RAW_RETENTION_DAYS=730

# --- Gemini (shelf-scan OCR, Q&A citations) -------------------------------
GEMINI_API_KEY=
# GLOWUPAI_GEMINI_API_KEY=
GLOWUPAI_GEMINI_MODEL=gemini-3.5-flash-lite
GLOWUPAI_GEMINI_ENABLED=1

# --- Firebase auth ---------------------------------------------------------
# Required for POST /api/auth/session and for GLOWUPAI_AUTH_REQUIRED=1 to
# do anything other than fail closed. No service-account JSON needed --
# verification is JWKS-based (see glowupai/auth.py).
GLOWUPAI_FIREBASE_PROJECT_ID=
# Defaults OFF so the existing test suite and any unauthenticated caller
# keep working. Flip to 1 once the Android app is wired to send bearer
# tokens on every user-scoped route.
GLOWUPAI_AUTH_REQUIRED=0

# --- Admin routes ----------------------------------------------------------
# Unset -> every /api/admin/* route (including the audit log) is hard
# disabled with 403. Set a long random value to enable them, and never
# reuse it anywhere else.
GLOWUPAI_ADMIN_TOKEN=

# --- Environment / model versioning ----------------------------------------
# MUST be "production" on every real deploy -- see the security note in
# DEPLOY.md about the legacy Gemini-key file bridge.
GLOWUPAI_ENV=production
# Belt-and-suspenders: forces the legacy first.py key bridge off regardless
# of GLOWUPAI_ENV. Set explicitly in production; do not rely on GLOWUPAI_ENV alone.
GLOWUPAI_DISABLE_LEGACY_KEY_FILE=1
GLOWUPAI_MODEL_VERSION=deterministic-3.0
GLOWUPAI_POLICY_VERSION=2026-01

# --- CORS Configuration ------------------------------------------------
# REQUIRED IN PRODUCTION: Comma-separated list of allowed origins
# Development default: localhost and emulator addresses
# Production: Must be explicitly configured
GLOWUPAI_ALLOWED_ORIGINS=https://app.glowup.ai,https://www.glowup.ai

# --- Production Features -----------------------------------------------
# Logging
GLOWUPAI_LOG_LEVEL=INFO
GLOWUPAI_JSON_LOGS=1

# Rate Limiting
GLOWUPAI_RATE_LIMIT_ENABLED=1

# Request Timeout (seconds)
GLOWUPAI_REQUEST_TIMEOUT=30

# OpenTelemetry (optional - for advanced observability)
OTEL_ENABLED=0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4317
# OTEL_SERVICE_NAME=glowupai

# --- Runtime ----------------------------------------------------------
# Injected by Railway/Render at runtime; do not hardcode. Only needed
# locally if you want to run uvicorn directly instead of the CLI/Docker
# defaults.
# PORT=8000

# Number of Uvicorn workers (adjust based on CPU cores)
# Formula: (2 * num_cores) + 1
# UVICORN_WORKERS=2
